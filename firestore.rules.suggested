// اقتراح قواعد Firestore — راجعها قبل النشر من Firebase Console > Firestore > Rules
// (الحماية الحقيقية للبيانات تكون هنا، وليس في الواجهة فقط)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // المنتجات: الكل يقرأ، المدير فقط يكتب
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الطلبات: العميل ينشئ ويقرأ طلباته فقط، والمدير يقرأ ويعدّل الكل
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // السلة والمستخدمون: صاحب الحساب فقط
    match /carts/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; allow read: if isAdmin(); }

    // قائمة المديرين: تُنشأ يدوياً من Console فقط
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
}
