// قواعد Firestore لمتجر سراب — الحماية الحقيقية للبيانات هنا وليست في الواجهة.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // المنتجات والأقسام ومناطق الشحن ومحتوى الموقع: الكل يقرأ، المدير فقط يكتب
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sections/{id} { allow read: if true; allow write: if isAdmin(); }
    match /zones/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // الطلبات: العميل ينشئ طلبه (بحالة "بانتظار التحويل" فقط) ويقرأ طلباته، والمدير يقرأ ويعدّل الكل
    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.cartItems is list
        && request.resource.data.cartItems.size() > 0
        && request.resource.data.cartItems.size() <= 50
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice > 0
        && request.resource.data.payNow is number
        && request.resource.data.payNow >= 0
        && request.resource.data.zoneId is string
        && exists(/databases/$(database)/documents/zones/$(request.resource.data.zoneId))
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 20
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.addressDetail.size() <= 600
        && request.resource.data.notes.size() <= 600;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // بيانات العميل: صاحب الحساب فقط، والمدير يقرأ (لإرسال العروض)
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // سجل الرسائل الترويجية: للمدير فقط
    match /promos/{id} { allow read, write: if isAdmin(); }

    // قائمة المديرين: تُنشأ يدوياً من Firebase Console فقط
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
  }
}
